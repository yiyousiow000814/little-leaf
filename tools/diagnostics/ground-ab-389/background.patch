+	func batches(limit: int) -> Array[Dictionary]:
+		# Keep the exact painter index order; only whole nonintersecting chunks
+		# may be omitted. Copy the author's vertex colors and AA offsets.
+		var result: Array[Dictionary] = []
+		for first in range(0, full.indices.size(), limit * 3):
+			var positions := PackedVector2Array()
+			var offsets := PackedVector2Array()
+			var colors := PackedColorArray()
+			var indices := PackedInt32Array()
+			var remap: Dictionary = {}
+			var rect := Rect2(center.vertices[full.indices[first]], Vector2.ZERO)
+			var extent := Vector2.ZERO
+			for i in range(first, mini(first + limit * 3, full.indices.size())):
+				var previous: int = full.indices[i]
+				if not remap.has(previous):
+					remap[previous] = positions.size()
+					var point: Vector2 = center.vertices[previous]
+					var bias: Vector2 = full.vertices[previous] - point
+					positions.append(point); offsets.append(bias); colors.append(full.colors[previous])
+					rect = rect.expand(point)
+					extent = extent.max(bias.abs())
+				indices.append(remap[previous])
+			var arrays := []
+			arrays.resize(Mesh.ARRAY_MAX)
+			arrays[Mesh.ARRAY_VERTEX] = positions
+			arrays[Mesh.ARRAY_TEX_UV] = offsets
+			arrays[Mesh.ARRAY_COLOR] = colors
+			arrays[Mesh.ARRAY_INDEX] = indices
+			var mesh := ArrayMesh.new()
+			mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays, [], {}, Mesh.ARRAY_FLAG_USE_2D_VERTICES)
+			mesh.custom_aabb = AABB(Vector3(-100000, -100000, -1), Vector3(200000, 200000, 2))
+			result.append({"mesh":mesh,"rect":rect,"extent":extent,"triangles":indices.size() / 3})
+		return result
