+++ b/core/profiling/ll397_native_scopes.h
@@ -0,0 +1,227 @@
+#pragma once
+// Diagnostic-only Godot Linux x86_64 source variant. No GL calls or hot-path I/O.
+#ifdef LL397_ENGINE_DIAG
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <ctime>
+#include <cstring>
+
+namespace LL397 {
+enum Bucket : uint8_t {
+	SYNC, RENDER_OTHER, RENDER_BEGIN, OLD_GL_QUERY, PREPARE, VIEWPORT_OTHER,
+	CANVAS_CULL, CANVAS_SUBMIT, SCREEN_BLIT, BUFFER_SWAP, EXISTING_FINISH, NOTIFIERS, POST_CALLBACKS, N_BUCKETS
+};
+inline constexpr const char *LABELS[] = {
+	"sync", "render_other", "render_begin", "older_gl_query_and_begin", "prepare",
+	"viewport_other", "canvas_cull", "canvas_submit", "screen_blit", "buffer_swap",
+	"existing_finish", "visibility_notifiers", "post_callbacks"
+};
+static_assert(sizeof(LABELS) / sizeof(*LABELS) == N_BUCKETS);
+struct Pair {
+	int64_t wall = 0;
+	int64_t cpu = 0;
+};
+inline bool stamp(Pair &out) {
+	timespec wall{}, cpu{};
+	if (clock_gettime(CLOCK_MONOTONIC, &wall) || clock_gettime(CLOCK_THREAD_CPUTIME_ID, &cpu)) {
+		return false;
+	}
+	out = {wall.tv_sec * int64_t{1000000000} + wall.tv_nsec,
+		cpu.tv_sec * int64_t{1000000000} + cpu.tv_nsec};
+	return true;
+}
+inline Pair diff(Pair a, Pair b) {
+	return {a.wall - b.wall, a.cpu - b.cpu};
+}
+struct Row {
+	uint64_t id = 0;
+	bool detail = false;
+	Pair outer, tail;
+	std::array<Pair, N_BUCKETS> spent{};
+	std::array<uint32_t, N_BUCKETS> calls{};
+};
+struct State {
+	static constexpr size_t CAP = 512;
+	std::array<Row, CAP> rows{};
+	std::array<Bucket, 10> stack{};
+	Row row{};
+	Pair last{}, pre{}, post{};
+	std::array<char, 4096> output{};
+	size_t used = 0, errors = 0, depth = 0;
+	bool initialized = false, current = false, seen_pre = false, seen_post = false;
+};
+inline thread_local State state;
+inline bool phase_stamp(Pair &out) {
+	if (!stamp(out)) {
+		state.errors++;
+		return false;
+	}
+	return true;
+}
+inline void accrue(Pair now) {
+	if (!state.depth) {
+		return;
+	}
+	const Pair delta = diff(now, state.last);
+	if (delta.wall < 0 || delta.cpu < 0) {
+		state.errors++;
+		return;
+	}
+	Pair &dest = state.row.spent[state.stack[state.depth - 1]];
+	dest.wall += delta.wall;
+	dest.cpu += delta.cpu;
+}
+inline bool push_at(Bucket name, Pair now) {
+	if (state.depth == state.stack.size()) {
+		state.errors++;
+		return false;
+	}
+	accrue(now);
+	state.last = now;
+	state.stack[state.depth++] = name;
+	state.row.calls[name]++;
+	return true;
+}
+inline void pop_at(Bucket name, Pair now) {
+	if (!state.depth || state.stack[state.depth - 1] != name) {
+		state.errors++;
+		return;
+	}
+	accrue(now);
+	state.last = now;
+	--state.depth;
+}
+struct Scope {
+	Bucket name;
+	bool active = false;
+	explicit Scope(Bucket bucket) : name(bucket) {
+		if (state.current && (name == SYNC || (state.row.detail && state.depth))) {
+			Pair now;
+			active = phase_stamp(now) && push_at(name, now);
+		}
+	}
+	~Scope() {
+		close();
+	}
+	void close() {
+		if (active) {
+			active = false;
+			Pair now;
+			if (phase_stamp(now)) {
+				pop_at(name, now);
+			}
+		}
+	}
+	Scope(const Scope &) = delete;
+	Scope &operator=(const Scope &) = delete;
+};
+inline void dump() {
+	if (!state.output[0]) {
+		return;
+	}
+	// The harness supplies a fixed fresh output in its private synthetic directory.
+	std::FILE *f = std::fopen(state.output.data(), "wx");
+	if (!f) {
+		return; // Missing output fails closed in the harness.
+	}
+	std::fprintf(f, "ll397-engine-scopes-v1\terrors\t%zu\n", state.errors);
+	std::fputs("frame\tdetail\touter_wall_ns\touter_thread_cpu_ns\ttail_wall_ns\ttail_thread_cpu_ns", f);
+	for (const char *label : LABELS) {
+		std::fprintf(f, "\t%s_wall_ns\t%s_thread_cpu_ns\t%s_calls", label, label, label);
+	}
+	std::fputc('\n', f);
+	for (size_t i = 0; i < state.used; ++i) {
+		const Row &r = state.rows[i];
+		std::fprintf(f, "%llu\t%u\t%lld\t%lld\t%lld\t%lld",
+			(unsigned long long)r.id, unsigned(r.detail), (long long)r.outer.wall,
+			(long long)r.outer.cpu, (long long)r.tail.wall, (long long)r.tail.cpu);
+		for (size_t j = 0; j < N_BUCKETS; ++j) {
+			std::fprintf(f, "\t%lld\t%lld\t%u",
+				(long long)r.spent[j].wall, (long long)r.spent[j].cpu, unsigned(r.calls[j]));
+		}
+		std::fputc('\n', f);
+	}
+	std::fclose(f);
+}
+inline void begin(uint64_t serial) {
+	if (!state.initialized) {
+		state.initialized = true;
+		const char *path = std::getenv("LL397_ENGINE_TRACE");
+		if (path && path[0] == '/' && std::strlen(path) < state.output.size() && !std::atexit(dump)) {
+			std::strcpy(state.output.data(), path);
+		}
+	}
+	if (!state.output[0]) {
+		return;
+	}
+	const char *arm = std::getenv("LL397_ENGINE_ARM");
+	if (!arm || (arm[0] != '0' && arm[0] != '1') || arm[1]) {
+		return;
+	}
+	if (state.current || state.depth) {
+		state.errors++;
+		return;
+	}
+	state.row = {};
+	state.row.id = serial;
+	state.row.detail = arm[0] == '1';
+	state.seen_pre = state.seen_post = false;
+	state.current = true;
+}
+inline void render_begin(bool separate) {
+	if (!state.current) {
+		return;
+	}
+	if (separate || state.seen_pre || state.depth) {
+		state.errors++;
+		return;
+	}
+	if (!phase_stamp(state.pre)) {
+		return;
+	}
+	state.seen_pre = true;
+	if (state.row.detail) {
+		push_at(RENDER_OTHER, state.pre);
+	}
+}
+inline void render_end() {
+	if (!state.current) {
+		return;
+	}
+	if (!state.seen_pre || state.seen_post || state.depth != unsigned(state.row.detail)) {
+		state.errors++;
+		return;
+	}
+	if (!phase_stamp(state.post)) {
+		return;
+	}
+	if (state.row.detail) {
+		pop_at(RENDER_OTHER, state.post);
+	}
+	state.row.outer = diff(state.post, state.pre);
+	state.seen_post = true;
+}
+inline void end() {
+	if (!state.current) {
+		return;
+	}
+	Pair now;
+	if (!state.seen_pre || !state.seen_post || state.depth || !phase_stamp(now) || state.used == state.CAP) {
+		state.errors++;
+	} else {
+		state.row.tail = diff(now, state.post);
+		state.rows[state.used++] = state.row;
+	}
+	state.current = false;
+}
+} // namespace LL397
+#define LL397_POINT(expr) LL397::expr
+#define LL397_SCOPE(bucket) LL397::Scope ll397_scope_##bucket(LL397::bucket)
+#define LL397_CLOSE(bucket) ll397_scope_##bucket.close()
+#else
+#define LL397_POINT(expr) ((void)0)
+#define LL397_SCOPE(bucket) ((void)0)
+#define LL397_CLOSE(bucket) ((void)0)
+#endif // LL397_ENGINE_DIAG
