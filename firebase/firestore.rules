rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid}/saves/cafe {
      function owner() { return request.auth != null && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider == 'google.com'; }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasAll(['schema','profileId','revision','digest','record'])
          && d.keys().hasOnly(['schema','profileId','revision','digest','record'])
          && d.schema == 1 && d.profileId is string && d.profileId.size() == 36
          && d.revision is int && d.revision > 0 && d.revision <= 9007199254740991
          && d.digest is string && d.digest.matches('^[a-f0-9]{64}$')
          && d.record is string && d.record.size() <= 900000;
      }
      allow get: if owner();
      allow create: if owner() && valid();
      allow update: if owner() && valid() && request.resource.data.profileId == resource.data.profileId
        && request.resource.data.revision > resource.data.revision;
      allow list, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
