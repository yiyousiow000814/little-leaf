extends SceneTree
const Main=preload("res://scripts/main.gd")
const CELL=Vector2i(4,4)
var checks=0
var failures=[]
var evidence=[]
func check(ok:bool,label:String):
 checks+=1
 if not ok:failures.append(label);printerr("FAIL ",label)
func worker(g,role:String)->Dictionary:
 for staff in g.staff_states:
  if staff.role==role:return staff
 return {}
func fixture(cleaner_first:bool,stage:int=0):
 var g=Main.new();g.save_writes_suppressed=true;g.MinimalStart.apply(g.model)
 g.model.first_guest_pending=false;g.model._spawn_customer();g.model.operating_open=false;g._update_people()
 var guest=g.model.customers[0]
 var table=g.model.get_item(int(guest.table_id));table.x=4;table.z=3;table.rot=2
 var chair=g.model.get_item(int(guest.chair_id));chair.x=4;chair.z=2;chair.rot=2
 for item in g.model.items:
  if item.kind=="sink":item.x=8;item.z=3
  if item.kind=="register":item.x=9;item.z=6
 for cell in [Vector2i(3,3),Vector2i(5,3),Vector2i(4,1)]:
  g.model.items.append({"id":100+g.model.items.size(),"kind":"plant","x":cell.x,"z":cell.y,"rot":0})
 g.model._next_item_id=200;g.model.rebuild_dining_sets();g.model.revision+=1
 guest.phase="cooking";guest.seated=true;guest.admitted=true;guest.waiting=false;guest.x=4.5;guest.z=2.5;guest.route=[];guest.route_index=0
 g._sync_service_guests()
 var waiter=worker(g,"waiter");var cleaner=worker(g,"cleaner")
 g.staff_states.erase(waiter);g.staff_states.erase(cleaner)
 g.staff_states.push_front(waiter if cleaner_first else cleaner);g.staff_states.push_front(cleaner if cleaner_first else waiter)
 var record=g.service_guests[int(guest.id)]
 record.order_done=true;record.meal_ready=true;record.meal_done=false;record.plate_owner="staff";record.plate_target_id=-1;record.plate_staff_index=g.staff_states.find(waiter)
 waiter.job_kind="deliver_meal";waiter.job_guest_id=guest.id;waiter.job_token=record.token;waiter.job_step=1;waiter.job_elapsed=.1
 waiter.pos=Vector2(CELL)+Vector2(.5,.5);waiter.destination=Vector2i(-100,-100);waiter.path=[]
 cleaner.pos=Vector2(CELL)+Vector2(.5,.5)
 var id=g.floor_tasks.spawn(Vector2i(5,4),"banana",91,3)
 check(id>0,"generated litter is on actual open eligible floor")
 if id<0:return g
 var entry=g.floor_tasks.messes[id];entry.floor_work_cell=CELL
 g.floor_tasks.assign(cleaner,g.staff_states.find(cleaner))
 check(cleaner.job_kind=="floor" and entry.floor_work_cell==CELL,"actual cleaner claim uses the shared service-side cell")
 cleaner.destination=CELL;cleaner.job_elapsed=.1
 if stage==2:
  cleaner.job_step=2;entry.trash_owner="staff";entry.trash_staff_index=g.staff_states.find(cleaner)
 elif stage==3:
  cleaner.job_step=3;entry.floor_debris="none";entry.trash_owner="none";entry.floor_spill=true;entry.spill_cleaned=false;entry.spill_remaining=1.0;entry.erase("mess_shape")
  g.floor_tasks.geometry.ensure(entry);entry.floor_work_cell=CELL
 return g
func release(g):g.people.free();g.ui.free();g.free()
func roundtrip(g,label:String):
 var before=g._service_save_snapshot();var coins=g.model.coins
 g.model.service_snapshot=before
 var path="user://floor-table-"+label+".json"
 var saved=g.model.save(path);check(saved,label+" shared endpoints save: "+g.model.last_error)
 if not saved:return
 var digest=FileAccess.get_sha256(path)
 var loaded=g.model.load_save(path);check(loaded,label+" shared endpoints reload: "+g.model.last_error)
 if not loaded:return
 g._restore_service_runtime()
 check(FileAccess.get_sha256(path)==digest and g.model.coins==coins,label+" reload leaves generated bytes and wallet unchanged")
 var waiter=worker(g,"waiter");var cleaner=worker(g,"cleaner")
 var a=before.staff.filter(func(s):return s.role=="waiter")[0];var b=before.staff.filter(func(s):return s.role=="cleaner")[0]
 check(waiter.pos.is_equal_approx(a.pos) and cleaner.pos.is_equal_approx(b.pos) and is_equal_approx(waiter.job_elapsed,a.job_elapsed) and is_equal_approx(cleaner.job_elapsed,b.job_elapsed),label+" shared positions and both work clocks survive reload")
 check(waiter.job_token==a.job_token and cleaner.job_token==b.job_token and cleaner.job_mess_id==b.job_mess_id,label+" independent task identities survive reload")
func tick(g):g._animate_staff(.05)
func report():
 print("WORK_CLAIM_POLICY_RESULT ",JSON.stringify({"checks":checks,"failures":failures,"evidence":evidence,"player_save_used":false}))
 quit(0 if failures.is_empty() else 1)
func _initialize():run.call_deferred()
func run():
 # First assertion is the same failed-before/passed-after real controller case.
 for cleaner_first in [true,false]:
  for stage in [0,2,3]:
   var g=fixture(cleaner_first,stage);var waiter=worker(g,"waiter");var cleaner=worker(g,"cleaner")
   var before_waiter=waiter.job_elapsed;var before_cleaner=cleaner.job_elapsed
   tick(g)
   var shared=waiter.destination==CELL and cleaner.destination==CELL and waiter.job_elapsed>before_waiter and cleaner.job_elapsed>before_cleaner
   check(shared,"unrelated table and floor stage "+str(stage)+" progress together, cleaner_first="+str(cleaner_first))
   evidence.append({"cleaner_first":cleaner_first,"floor_stage":stage,"waiter_destination":str(waiter.destination),"cleaner_destination":str(cleaner.destination),"waiter_elapsed":waiter.job_elapsed,"cleaner_elapsed":cleaner.job_elapsed})
   if not shared:release(g);report();return
   check(g._staff_route(g.staff_states.find(waiter),Vector2i(6,4)).has(Vector2i(5,4)),"actor sharing does not change ordinary static transit")
   var held=g.service_guests.values()[0]
   check(held.plate_owner=="staff" and held.plate_staff_index==g.staff_states.find(waiter),"table worker keeps exclusive meal custody")
   if cleaner_first:roundtrip(g,"stage-"+str(stage))
   release(g)
 # Prospective assignment cannot require an already-assigned job kind.
 var g=fixture(true);var waiter=worker(g,"waiter");var cleaner=worker(g,"cleaner");var record=g.service_guests.values()[0]
 g._clear_service_job(waiter);record.guest.phase="ordering";record.order_done=false;record.meal_ready=false;record.plate_owner="kitchen";record.plate_staff_index=-1
 g._assign_service_job(waiter,g.staff_states.find(waiter))
 check(waiter.job_kind=="order" and waiter.table_face_cell==CELL,"unassigned waiter accepts order without waiting for floor cleaner")
 var token=waiter.job_token
 var second={}
 g._add_staff("waiter",Vector2(2.5,4.5));second=g.staff_states[-1]
 g._assign_service_job(second,g.staff_states.size()-1)
 check(second.job_kind=="" and waiter.job_token==token,"a second waiter never receives the same order")
 release(g)
 g=fixture(false);waiter=worker(g,"waiter");cleaner=worker(g,"cleaner")
 waiter.destination=CELL;waiter.table_face_cell=CELL;waiter.table_face_id=int(g.model.customers[0].table_id)
 g._clear_service_job(cleaner);g.floor_tasks.assign(cleaner,g.staff_states.find(cleaner))
 check(cleaner.job_kind=="floor" and g.floor_tasks.record(cleaner).floor_work_cell==CELL,"unassigned cleaner retains reachable pinned side beside active table waiter")
 var mess_id=cleaner.job_mess_id
 g._add_staff("cleaner",Vector2(6.5,4.5));second=g.staff_states[-1]
 g.floor_tasks.assign(second,g.staff_states.size()-1)
 check(second.job_kind=="" and cleaner.job_mess_id==mess_id,"a second cleaner never receives the same litter")
 release(g)
 # Earlier completion must not turn a compatible frame claim anonymous.
 for finish in ["sweep","disposal","waiter"]:
  g=fixture(finish!="waiter",2 if finish=="disposal" else 0);waiter=worker(g,"waiter");cleaner=worker(g,"cleaner")
  if finish=="waiter":waiter.job_elapsed=.79
  elif finish=="sweep":cleaner.job_elapsed=.84
  else:cleaner.job_elapsed=.89
  tick(g)
  if finish=="waiter":check(cleaner.job_elapsed>.1,"floor work advances after preceding table worker completes")
  else:check(waiter.job_elapsed>.1,"table work advances after preceding "+finish+" finishes")
  if finish=="sweep":check(cleaner.job_step==2,"local disposal follows sweep without reblocking the table")
  if finish=="disposal":check(g.floor_tasks.completed==1 and cleaner.job_kind=="","litter disposal completes exactly once")
  release(g)
 # Distinct table resources share stance even when the earlier waiter
 # completes this frame; task identity, not role, decides compatibility.
 g=fixture(false);waiter=worker(g,"waiter");cleaner=worker(g,"cleaner")
 var second_guest=g.model.customers[0].duplicate(true);second_guest.id=2;second_guest.table_id=200;second_guest.chair_id=201;second_guest.x=3.5;second_guest.z=5.5
 g.model.customers.append(second_guest)
 g.model.items.append({"id":200,"kind":"table","x":3,"z":4,"rot":0})
 g.model.items.append({"id":201,"kind":"chair","x":3,"z":5,"rot":0})
 g.model.items.append({"id":202,"kind":"plant","x":2,"z":4,"rot":0});g.model.revision+=1
 g._sync_service_guests();g._add_staff("waiter",Vector2(CELL)+Vector2(.5,.5));second=g.staff_states[-1]
 g.staff_states.erase(second);g.staff_states.insert(2,second)
 var second_record=g.service_guests[2]
 second_record.order_done=true;second_record.meal_ready=true;second_record.meal_done=false;second_record.plate_owner="staff";second_record.plate_target_id=-1;second_record.plate_staff_index=2
 second.job_kind="deliver_meal";second.job_guest_id=2;second.job_token=second_record.token;second.job_step=1;second.job_elapsed=.1
 waiter.job_elapsed=.79;tick(g)
 check(waiter.job_kind=="" and cleaner.job_elapsed>.1,"first table worker completes while independent cleaner proceeds")
 check(second.job_elapsed>.1 and second.destination==CELL,"different table continues through the earlier table completion snapshot")
 release(g)
 # Snapshot accounting never waives anonymous extras or duplicate ownership.
 g=fixture(true);waiter=worker(g,"waiter");cleaner=worker(g,"cleaner")
 var target=g.model.get_item(int(g.model.customers[0].table_id))
 var intent=g._work_intent(waiter,target,CELL)
 var floor_claim=g._work_intent(cleaner,g._service_target(cleaner),CELL)
 var frames={g.staff_states.find(cleaner):floor_claim}
 check(g._work_cell_available(CELL,waiter,intent,[CELL],frames),"one compatible resource accounts for only its own frame claim")
 check(not g._work_cell_available(CELL,waiter,intent,[CELL,CELL],frames),"an extra anonymous same-cell claim remains exclusive")
 var duplicate=intent.duplicate(true);duplicate.worker=99
 frames={g.staff_states.find(cleaner):duplicate}
 check(not g._work_cell_available(CELL,waiter,intent,[CELL],frames),"a completed duplicate task snapshot cannot grant the same task twice")
 frames={g.staff_states.find(cleaner):{"cell":CELL,"productive":false,"claimed":true}}
 check(g._work_cell_available(CELL,waiter,intent,[CELL],frames),"idle fallback does not become productive ownership")
 # Existing real equipment, rather than a fake destination label, is exclusive.
 var chef=worker(g,"chef");var stove=g.model.get_item(1);stove.x=4;stove.z=5;stove.rot=2;g.model.revision+=1
 chef.job_kind="cook";chef.job_guest_id=waiter.job_guest_id;chef.job_token=waiter.job_token;chef.job_step=0;chef.station_id=1;chef.destination=CELL
 var equipment=g._staff_work_claim(chef,CELL)
 check(not equipment.is_empty(),"exclusive equipment claim has a real reachable authored workface")
 equipment.task=["guest",999,999,"service"]
 frames={g.staff_states.find(chef):equipment}
 check(not g._work_cell_available(CELL,waiter,intent,[CELL],frames),"actual equipment workspace excludes unrelated simultaneous table contact")
 g._clear_service_job(chef)
 # Ledger origin does not change the non-equipment floor contact policy.
 var legacy=g._floor_work_intent(cleaner,g.service_guests.values()[0],CELL)
 var table_cleanup=intent.duplicate(true);table_cleanup.task=["guest",waiter.job_guest_id,waiter.job_token,"table"]
 check(not g.WorkClaims.conflicts(table_cleanup,legacy),"same visit table payload and legacy floor are separate task domains")
 check(g.WorkClaims.task_conflicts(intent.task,g.WorkClaims.task(waiter)),"same table task identity still conflicts")
 # Actual obstacles still win, independent of actor compatibility.
 g.model.items.append({"id":999,"kind":"plant","x":CELL.x,"z":CELL.y,"rot":0});g.model.revision+=1
 check(g._table_service_destination(waiter,target,CELL,[])==Vector2i(-1,-1),"real furnishing still blocks shared table endpoint")
 check(not g.floor_tasks.geometry.work_cells(g.floor_tasks.record(cleaner)).has(CELL),"real furnishing still blocks cleaner physical approach")
 release(g)
 equipment_owner_cases()
 fallback_and_legacy_cases()
 restore_ownership_case()
 report()

func fallback_and_legacy_cases():
 # Idle and a real-but-blocked equipment fallback cannot monopolize any work.
 for mode in ["idle","blocked_target","targetless","layout_hold"]:
  var g=fixture(true);var waiter=worker(g,"waiter");var cleaner=worker(g,"cleaner");var chef=worker(g,"chef")
  g.staff_states.erase(chef);g.staff_states.push_front(chef)
  g.service_guests.values()[0].plate_staff_index=g.staff_states.find(waiter)
  chef.pos=Vector2(CELL)+Vector2(.5,.5);chef.destination=CELL
  var stove=g.model.get_item(1);stove.x=8;stove.z=1;stove.rot=0
  g.model.items.append({"id":998,"kind":"plant","x":8,"z":2,"rot":0});g.model.revision+=1
  if mode!="idle":
   chef.job_kind="cook";chef.job_guest_id=waiter.job_guest_id;chef.job_token=waiter.job_token;chef.job_step=0;chef.station_id=1
   if mode=="targetless":chef.job_step=3;g.service_guests.values()[0].meal_pass_id=-1
   if mode=="layout_hold":g.model.service_snapshot.layout_hold={"staff":[{"index":0}]}
  check(not g._staff_owns_work_endpoint(chef,CELL),mode+" does not own the table/floor work cell")
  var entry=g.floor_tasks.record(cleaner)
  check(g.floor_tasks.geometry.available(CELL,cleaner,[]),mode+" does not block floor contact through a second ownership definition")
  # A targetless cook assigned to this artificial guest is only a direct
  # classifier probe; normal assignment/restore rejects duplicate task owners.
  if mode in ["idle","blocked_target"]:
   tick(g)
   check(waiter.job_elapsed>.1 and cleaner.job_elapsed>.1,mode+" lets actual table and floor clocks progress")
  release(g)
 # Saved diner floor and table cleanup for the same visit can both be assigned.
 var g=fixture(true);var waiter=worker(g,"waiter");var cleaner=worker(g,"cleaner");var record=g.service_guests.values()[0]
 var mess=g.floor_tasks.record(cleaner).duplicate(true)
 g._clear_service_job(waiter);g._clear_service_job(cleaner);g.floor_tasks.messes.clear()
 record.guest.phase="dirty";record.guest.seated=false;record.guest.dismounting=false;record.guest.paid=true;record.guest.x=-1.5;record.guest.z=6.5
 record.plate_owner="dish_queue";record.plate_staff_index=-1;record.dishes_collected=true;record.drink_owner="cleared";record.table_wiped=false
 for key in ["floor_cell","floor_target","debris_target","spill_target","floor_debris","floor_spill","spill_cleaned","spill_remaining","floor_dirty","floor_cleaned","trash_owner","trash_staff_index","trash_target_id","mess_shape","floor_work_cell"]:record[key]=mess[key]
 g._assign_service_job(waiter,g.staff_states.find(waiter));g._assign_service_job(cleaner,g.staff_states.find(cleaner))
 check(waiter.job_kind=="cleanup" and waiter.job_step==2 and cleaner.job_kind=="cleanup" and cleaner.job_step==3,"same visit grants separate table and legacy-floor tasks, not one whole-guest lock")
 waiter.pos=Vector2(CELL)+Vector2(.5,.5);cleaner.pos=waiter.pos;waiter.destination=CELL;cleaner.destination=CELL
 tick(g)
 check(waiter.job_elapsed>0 and cleaner.job_elapsed>0,"legacy floor and table contacts both progress at one stance")
 release(g)

func restore_ownership_case():
 var g=fixture(true);var waiter=worker(g,"waiter");var cleaner=worker(g,"cleaner");var record=g.service_guests.values()[0]
 # Produce a valid one-order save with the real roster, then duplicate only
 # ownership while keeping the declared roster/duty counts consistent.
 g._clear_service_job(waiter);g._clear_service_job(cleaner);g.floor_tasks.messes.clear()
 record.guest.phase="ordering";record.order_done=false;record.meal_ready=false;record.meal_done=false;record.plate_owner="kitchen";record.plate_staff_index=-1
 g._assign_service_job(waiter,g.staff_states.find(waiter))
 g.model.service_snapshot=g._service_save_snapshot()
 var good="user://work-claim-valid.json"
 check(g.model.save(good),"valid original order fixture saves before malformed duplicate probe: "+g.model.last_error)
 var payload=JSON.parse_string(FileAccess.get_file_as_string(good))
 var encoded=payload.runtime.service.staff.filter(func(s):return s.role=="waiter")[0].duplicate(true)
 payload.runtime.service.staff.append(encoded)
 payload.waiters+=1
 payload.duty_counts.waiter+=1;payload.duty_targets.waiter+=1
 var bad="user://work-claim-duplicate.json";var file=FileAccess.open(bad,FileAccess.WRITE);file.store_string(JSON.stringify(payload));file.close()
 var bytes=FileAccess.get_sha256(bad);var coins=g.model.coins;var identity=waiter.job_token
 check(not g.model.load_save(bad) and g.model.last_error.contains("Duplicate saved service task ownership"),"duplicate restored order reaches the dedicated shared task-owner guard")
 check(FileAccess.get_sha256(bad)==bytes and g.model.coins==coins and waiter.job_token==identity,"malformed restore preserves source bytes and live ownership/wallet")
 release(g)

func equipment_owner_cases():
 # A genuine in-flight exclusive workspace cannot be stolen by a different
 # shared-stance task, even when the equipment owner is later in the roster.
 for cleaner_first in [true,false]:
  var g=fixture(cleaner_first);var waiter=worker(g,"waiter");var cleaner=worker(g,"cleaner")
  g._clear_service_job(cleaner);g.floor_tasks.messes.clear()
  var sink={}
  for item in g.model.items:
   if item.kind=="sink":sink=item
  sink.x=4;sink.z=5;sink.rot=2;g.model.revision+=1
  g.dishwashing.dishes[1]={"id":1,"sink_id":int(sink.id),"elapsed":0.0};g.dishwashing.next_id=2
  cleaner.job_kind="wash";cleaner.job_dish_id=1;cleaner.job_token=1;cleaner.job_step=0;cleaner.station_id=int(sink.id)
  cleaner.pos=Vector2(6.5,4.5);cleaner.destination=CELL;cleaner.job_elapsed=0.0
  check(not g._staff_work_claim(cleaner,CELL).is_empty(),"in-flight sink owner has a real selected endpoint, cleaner_first="+str(cleaner_first))
  tick(g)
  check(is_equal_approx(waiter.job_elapsed,.1) and cleaner.destination==CELL,"independent table task preserves the selected sink workspace in both roster orders")
  cleaner.pos=Vector2(CELL)+Vector2(.5,.5);cleaner.path=[];cleaner.job_elapsed=19.96;g.dishwashing.dishes[1].elapsed=19.96
  waiter.pos=cleaner.pos;waiter.path=[]
  tick(g)
  check(g.dishwashing.completed==1 and is_equal_approx(waiter.job_elapsed,.1),"equipment completion keeps its exclusive current-frame claim")
  waiter.pos=Vector2(CELL)+Vector2(.5,.5);waiter.path=[]
  tick(g)
  check(waiter.job_elapsed>.1 and waiter.destination==CELL,"completed equipment ownership releases next frame without idle blocking")
  release(g)
